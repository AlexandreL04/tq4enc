@@ -121,6 +122,7 @@ void Qwen35Engine::verify_body(int n, int max_seq) {
                 rot_h(O, XH, zdim, n);
             }
             st("gdn_gated_rms+rot");
+            cal(L, 1, zdim, n);
             mm_h(L.w_out, M, n);
